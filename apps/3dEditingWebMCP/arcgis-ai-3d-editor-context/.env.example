# Milestone 0 capability-check configuration.
# Copy this file to .env (git-ignored) and fill in a real, disposable test
# service. Do not commit credentials, tokens, or private portal URLs.

# Portal URL. Leave unset to use ArcGIS Online (https://www.arcgis.com).
# VITE_PORTAL_URL=https://your-org.maps.arcgis.com

# Optional WebScene item id, shown in the left pane purely for visual context.
# VITE_WEBSCENE_ITEM_ID=00000000000000000000000000000000

# Set ONE of these to the 3D Object SceneLayer you want to check:
# VITE_SCENE_LAYER_URL=https://services.arcgis.com/.../SceneServer/layers/0
# VITE_SCENE_LAYER_ITEM_ID=00000000000000000000000000000000

# Disposable feature's OBJECTID used to probe live mesh-query support.
# Use a feature you are authorized to modify/discard; do not point this at
# production data.
# VITE_TEST_OBJECT_ID=1
